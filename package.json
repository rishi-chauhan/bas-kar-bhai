{
  "name": "bas-kar-bhai",
  "private": true,
  "description": "Test scripts only. The extension itself has no build step and no dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:e2e:firefox": "BROWSER=firefox node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "lint:firefox": "npx --yes web-ext@8 lint --source-dir extension",
    "build:firefox": "npx --yes web-ext@8 build --source-dir extension --artifacts-dir dist --overwrite-dest"
  }
}
